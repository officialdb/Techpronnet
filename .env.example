# Neon Postgres Connection String
# Get your connection string from the Neon Console: https://console.neon.tech
DATABASE_URL="postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/neondb?sslmode=require"

# Canonical Production Domain URL
# Used for metadataBase, sitemap.xml, robots.txt, Open Graph, and JSON-LD schemas.
# On Vercel, this automatically falls back to VERCEL_PROJECT_PRODUCTION_URL or VERCEL_URL if unset.
NEXT_PUBLIC_SITE_URL="https://techpronnet.com"
